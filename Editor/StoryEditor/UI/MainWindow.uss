.story-editor {
    flex-grow: 1;
    min-height: 0;
    padding: 4px;
}

.story-editor__toolbar {
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

#story-editor-title {
    -unity-font-style: bold;
    margin-left: 4px;
}

.story-editor__toolbar-actions {
    flex-direction: row;
}

.story-editor__toolbar-actions Button {
    margin-left: 2px;
}

.story-editor__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.story-editor__pane {
    min-height: 0;
    padding: 4px;
}

.story-editor__tree-pane {
    width: 250px;
    min-width: 220px;
    margin-right: 8px;
}

.story-editor__pane-header {
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.story-editor__pane-header Label {
    -unity-font-style: bold;
}

.story-editor__tree-scroll {
    flex-grow: 1;
    min-height: 0;
}

.story-editor__tree-row {
    height: 24px;
    min-width: 28px;
    margin-top: 2px;
    margin-left: 12px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.story-editor__tree-row:hover {
    background-color: rgba(89, 148, 226, 0.16);
}

.story-editor__tree-row--root {
    margin-left: 0;
    -unity-font-style: bold;
}

.story-editor__tree-row--selected {
    background-color: rgba(89, 148, 226, 0.32);
    color: rgb(238, 246, 255);
}

.story-editor__overview-volume-grid {
    margin-top: 6px;
}

.story-editor__overview-volume-card {
    width: 226px;
    height: 176px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding: 0;
    flex-direction: column;
    align-items: stretch;
    position: relative;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.28);
    background-color: rgba(0, 0, 0, 0.12);
    -unity-text-align: middle-left;
}

.story-editor__overview-volume-card:hover {
    background-color: rgba(89, 148, 226, 0.16);
    border-color: rgba(89, 148, 226, 0.55);
}

.story-editor__overview-volume-open {
    flex-grow: 1;
    height: 100%;
    margin: 0;
    padding: 0;
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-text-align: middle-left;
}

.story-editor__overview-volume-open:hover {
    background-color: rgba(0, 0, 0, 0);
}

.story-editor__overview-volume-preview {
    height: 86px;
    min-height: 86px;
    position: relative;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.18);
}

.story-editor__overview-volume-icon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.story-editor__overview-volume-index {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 22px;
    padding-top: 3px;
    background-color: rgba(0, 0, 0, 0.58);
    color: rgb(238, 238, 238);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.story-editor__overview-volume-details {
    flex-grow: 1;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 3px;
}

.story-editor__overview-volume-title {
    height: 19px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
}

.story-editor__overview-volume-metadata,
.story-editor__overview-volume-path,
.story-editor__overview-volume-validation--error,
.story-editor__overview-volume-validation--success {
    height: 17px;
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
}

.story-editor__overview-volume-metadata,
.story-editor__overview-volume-path {
    color: rgba(210, 210, 210, 0.72);
}

.story-editor__overview-volume-validation--error {
    color: rgb(235, 112, 112);
}

.story-editor__overview-volume-validation--success {
    color: rgb(122, 190, 132);
}

.story-editor__overview-volume-delete {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 24px;
    height: 22px;
    margin: 0;
    padding: 3px;
}

.story-editor__overview-volume-delete-icon {
    width: 16px;
    height: 16px;
}

.story-editor__overview-volume-add {
    width: 226px;
    height: 176px;
    margin-right: 6px;
    margin-bottom: 6px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.36);
    background-color: rgba(0, 0, 0, 0.08);
}

.story-editor__overview-volume-add:hover {
    background-color: rgba(89, 148, 226, 0.12);
    border-color: rgba(89, 148, 226, 0.55);
}

.story-editor__overview-volume-add-icon {
    font-size: 42px;
    color: rgba(210, 210, 210, 0.82);
    -unity-text-align: middle-center;
}

.story-editor__workspace {
    flex-grow: 1;
    flex-direction: column;
    min-width: 560px;
    min-height: 0;
}

.story-editor__workspace-body {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
    min-height: 0;
}

.story-editor__breadcrumb {
    height: 34px;
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(33, 36, 41);
    border-width: 1px;
    border-color: rgb(54, 60, 68);
    border-radius: 4px;
    overflow: hidden;
}

.story-editor__breadcrumb-item {
    max-width: 260px;
    height: 24px;
    padding-left: 7px;
    padding-right: 7px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(153, 202, 174);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.story-editor__breadcrumb-item:hover {
    background-color: rgba(92, 184, 143, 0.14);
}

.story-editor__breadcrumb-separator {
    margin-left: 4px;
    margin-right: 4px;
    color: rgb(122, 133, 147);
}

.story-editor__breadcrumb-current {
    flex-grow: 1;
    min-width: 0;
    color: rgb(226, 232, 240);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.story-editor__graph-area {
    flex-grow: 1;
    min-width: 360px;
    min-height: 0;
    background-color: rgb(18, 20, 24);
    border-width: 1px;
    border-color: rgb(48, 55, 64);
    border-radius: 4px;
    overflow: hidden;
}

.story-editor .editor-node-graph-palette__item--flow {
    border-left-width: 3px;
    border-left-color: rgb(92, 184, 143);
}

.story-editor .editor-node-graph-palette__item--action {
    border-left-width: 3px;
    border-left-color: rgb(82, 156, 218);
}

.story-editor .editor-node-graph-palette__item--interaction {
    border-left-width: 3px;
    border-left-color: rgb(221, 171, 79);
}

.story-editor .editor-node-graph-palette__item--condition {
    border-left-width: 3px;
    border-left-color: rgb(169, 126, 219);
}

.story-editor .editor-node-graph-palette__item--auxiliary {
    border-left-width: 3px;
    border-left-color: rgb(134, 148, 166);
}

.story-editor .editor-node-graph-node--flow {
    border-left-width: 4px;
    border-left-color: rgb(92, 184, 143);
}

.story-editor .editor-node-graph-node--action {
    border-left-width: 4px;
    border-left-color: rgb(82, 156, 218);
}

.story-editor .editor-node-graph-node--interaction {
    border-left-width: 4px;
    border-left-color: rgb(221, 171, 79);
}

.story-editor .editor-node-graph-node--condition {
    border-left-width: 4px;
    border-left-color: rgb(169, 126, 219);
}

.story-editor .editor-node-graph-node--auxiliary {
    border-left-width: 4px;
    border-left-color: rgb(134, 148, 166);
}

.story-editor .story-video-reference {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
}

.story-editor .story-video-reference__summary {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.story-editor__section-title {
    -unity-font-style: bold;
    color: rgb(232, 237, 245);
    margin-top: 10px;
    margin-bottom: 6px;
}

.story-editor__status-bar {
    min-height: 22px;
    max-height: 22px;
    flex-shrink: 0;
    border-top: 1px solid rgb(60, 60, 60);
    background-color: rgb(40, 40, 40);
    overflow: visible;
    transition: max-height 0.15s ease-out;
}

.story-editor__status-bar--expanded {
    max-height: 220px;
}

.story-editor__status-bar-header {
    min-height: 22px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    cursor: pointer;
}

.story-editor__status-bar-header:hover {
    background-color: rgb(50, 50, 50);
}

.story-editor__status-bar-header--expanded {
    background-color: rgb(50, 50, 50);
}

.story-editor__status-bar-text {
    color: rgb(180, 190, 200);
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    flex-grow: 1;
}

.story-editor__status-bar-body {
    flex-direction: column;
    padding: 2px 0;
    max-height: 180px;
    overflow: scroll;
    border-top: 1px solid rgb(70, 70, 70);
}

.story-editor__issue--error {
    color: rgb(235, 96, 96);
}

.story-editor__issue--warning {
    color: rgb(226, 178, 82);
}

.story-editor__route-inspector {
    width: 268px;
    min-width: 240px;
    margin-left: 8px;
}

.story-editor__route-inspector-title {
    height: 24px;
    margin-bottom: 6px;
    color: rgb(226, 232, 240);
    -unity-font-style: bold;
}

.story-editor__route-inspector-scroll {
    flex-grow: 1;
    min-height: 0;
}

.story-editor__route-inspector-label {
    margin-top: 9px;
    margin-bottom: 3px;
    color: rgb(144, 157, 174);
    font-size: 11px;
}

.story-editor__route-inspector-value {
    min-height: 20px;
    color: rgb(220, 227, 236);
    white-space: normal;
}

.story-editor__route-inspector-field {
    margin-top: 8px;
    min-height: 22px;
}

.story-editor__navigation-header {
    flex-direction: row;
    align-items: center;
    min-height: 38px;
}

.story-editor__navigation-header .story-editor__breadcrumb {
    flex-grow: 0;
    flex-shrink: 1;
}

.story-editor__route-layout-toolbar {
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 8px;
}

.story-editor__route-layout-toggle {
    width: 58px;
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-right: 2px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(42, 47, 54);
    border-width: 1px;
    border-color: rgb(65, 73, 84);
    border-radius: 4px;
}

.story-editor__route-layout-toggle:hover {
    background-color: rgb(50, 58, 68);
    border-color: rgb(92, 110, 132);
}

.story-editor__route-layout-toggle--selected {
    background-color: rgb(54, 66, 82);
    border-color: rgb(122, 178, 244);
}

.story-editor__route-layout-toggle .unity-toggle__input {
    display: none;
}

.story-editor__route-layout-toggle-label {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
    color: rgb(207, 218, 232);
    -unity-text-align: middle-center;
}

.story-editor__route-layout-toggle--selected .story-editor__route-layout-toggle-label {
    color: rgb(235, 244, 255);
    -unity-font-style: bold;
}

.story-editor__route-layout-command {
    width: 28px;
    height: 24px;
    margin-left: 2px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.story-editor__route-layout-command-icon {
    width: 16px;
    height: 16px;
}

.story-editor__route-inspector-section {
    unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 4px;
}

.story-editor__route-inspector-preview {
    height: 150px;
    min-height: 150px;
    margin-top: 3px;
    background-color: rgb(18, 20, 24);
    border-width: 1px;
    border-color: rgb(54, 60, 68);
    border-radius: 4px;
}

.story-editor__route-canvas .editor-node-graph-palette {
    display: none;
}

.story-editor .editor-node-graph-node--route-root {
    border-left-width: 4px;
    border-left-color: rgb(92, 184, 143);
}

.story-editor .editor-node-graph-node--route-episode {
    border-left-width: 4px;
    border-left-color: rgb(82, 156, 218);
}

.story-editor .editor-node-graph-node--route-root .editor-node-graph-node__body,
.story-editor .editor-node-graph-node--route-episode .editor-node-graph-node__body {
    display: none;
}

.story-route-blackboard {
    min-width: 220px;
    padding: 7px;
    color: rgb(173, 203, 188);
}

.story-route-blackboard--error {
    color: rgb(235, 132, 112);
}

.story-editor__issue--info {
    color: rgb(126, 173, 255);
}

.story-editor__blackboard-status {
    white-space: normal;
    color: rgb(150, 210, 165);
}
