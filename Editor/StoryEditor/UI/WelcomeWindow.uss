.story-editor-welcome {
    flex-grow: 1;
    min-height: 0;
}

.story-editor-welcome__header {
    width: 100%;
    flex-shrink: 0;
}

.story-editor-welcome__content {
    width: 640px;
    max-width: 100%;
    padding: 12px;
    align-self: center;
}

.story-editor-welcome__title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-bottom: 4px;
}

.story-editor-welcome__subtitle {
    margin-bottom: 12px;
    white-space: normal;
}

.story-editor-welcome__section-title {
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
}

.story-editor-welcome__recent-list {
    margin-top: 2px;
}

.story-editor-welcome__recent-row {
    height: 22px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.story-editor-welcome__recent-link,
.story-editor-welcome__recent-remove-link {
    height: 20px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.story-editor-welcome__recent-link {
    flex-grow: 1;
}

.story-editor-welcome__recent-remove-link {
    width: 32px;
    flex-shrink: 0;
    margin-left: 8px;
}

.story-editor-welcome--dark .story-editor-welcome__recent-link,
.story-editor-welcome--dark .story-editor-welcome__recent-remove-link {
    color: rgb(76, 155, 214);
}

.story-editor-welcome--light .story-editor-welcome__recent-link,
.story-editor-welcome--light .story-editor-welcome__recent-remove-link {
    color: rgb(0, 109, 204);
}

.story-editor-welcome__recent-link:hover,
.story-editor-welcome__recent-remove-link:hover {
    color: rgb(111, 190, 246);
    background-color: rgba(0, 0, 0, 0);
}

.story-editor-welcome__recent-link:active,
.story-editor-welcome__recent-remove-link:active {
    background-color: rgba(0, 0, 0, 0);
}

.story-editor-welcome__recent-link--invalid {
    opacity: 0.5;
}

.story-editor-welcome__recent-empty {
    height: 24px;
    padding-left: 4px;
    -unity-text-align: middle-left;
}
